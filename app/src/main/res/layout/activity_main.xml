<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@+id/rootLayout" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera is the default home screen: launch and shoot immediately. -->
    <FrameLayout
        android:id="@+id/cameraPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="카메라 미리보기" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="30dp"
            android:paddingEnd="14dp">

            <Button
                android:id="@+id/btnCategoryPicker"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_camera_chip"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="💼 업무  ▾"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtCameraStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="94dp"
            android:background="@drawable/bg_camera_chip"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="카메라 준비 중"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/recordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="136dp"
            android:background="@drawable/bg_camera_chip"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Optional post-capture action. It never blocks the next shot. -->
        <LinearLayout
            android:id="@+id/quickSaveBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="176dp"
            android:background="@drawable/bg_camera_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="5dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtQuickSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사진 저장됨 · #사진"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnQuickTag"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="태그 추가"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="168dp"
            android:layout_gravity="bottom" android:orientation="vertical"
            android:background="#66000000" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingBottom="8dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="108dp">
                <FrameLayout android:id="@+id/btnOpenLibrary"
                    android:layout_width="60dp" android:layout_height="60dp"
                    android:layout_alignParentStart="true" android:layout_centerVertical="true"
                    android:clickable="true" android:focusable="true" android:contentDescription="앨범 열기">
                    <ImageView android:id="@+id/imgLatest" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:background="@drawable/bg_camera_circle"
                        android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="최근 사진" />
                    <TextView android:id="@+id/txtLatestType" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal"
                        android:background="#99000000" android:textColor="#FFFFFF" android:textSize="11sp" />
                </FrameLayout>
                <Button android:id="@+id/btnCapture" android:layout_width="82dp" android:layout_height="82dp"
                    android:layout_centerInParent="true" android:background="@drawable/bg_shutter_photo"
                    android:contentDescription="촬영" android:minWidth="0dp" android:padding="0dp"
                    android:text="" android:textColor="#FFFFFF" android:textSize="24sp" />
                <ImageButton android:id="@+id/btnSwitchCamera" android:layout_width="60dp" android:layout_height="60dp"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                    android:background="@drawable/bg_camera_circle" android:src="@drawable/ic_switch_camera"
                    android:padding="14dp" android:contentDescription="전면 후면 카메라 전환" />
            </RelativeLayout>
            <Button android:id="@+id/btnModeToggle" android:layout_width="160dp" android:layout_height="48dp"
                android:layout_gravity="center_horizontal" android:background="@drawable/bg_camera_chip"
                android:text="사진  /  동영상" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Gallery/search screen, opened from the bottom-left recent thumbnail. -->
    <LinearLayout
        android:id="@+id/libraryPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sc_background"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/sc_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/btnCloseLibrary"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_secondary_button"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="‹ 카메라"
                android:textAllCaps="false"
                android:textColor="@color/sc_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SortCam 앨범"
                android:textColor="@color/sc_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnManageCategories"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_secondary_button"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="분류"
                android:textAllCaps="false"
                android:textColor="@color/sc_text" />
        </LinearLayout>

        <Button android:id="@+id/btnImportPhotos" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp" android:background="@drawable/bg_primary_button"
            android:text="＋ 갤러리 원본 연결 (복사 없음)" android:textColor="#FFFFFF" android:textAllCaps="false" />
        <TextView android:id="@+id/txtImportStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="4dp" android:textSize="12sp" android:textColor="@color/sc_muted"
            android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <EditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:hint="검색어 여러 개: 업무 1234 계약서"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_muted"
            android:textSize="15sp" />

        <RadioGroup android:id="@+id/searchMode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp"
            android:checkedButton="@id/searchAll">
            <RadioButton android:id="@+id/searchAll" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:text="모두 포함" android:textSize="13sp" />
            <RadioButton android:id="@+id/searchAny" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:text="하나라도 포함" android:textSize="13sp" />
        </RadioGroup>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_primary_button"
                android:text="전체"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnFilterPhotos"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_secondary_button"
                android:text="📷 사진"
                android:textAllCaps="false"
                android:textColor="@color/sc_text" />
            <Button
                android:id="@+id/btnFilterVideos"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_secondary_button"
                android:text="🎬 동영상"
                android:textAllCaps="false"
                android:textColor="@color/sc_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPhotoCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="전체 0개"
            android:textColor="@color/sc_muted"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photoRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="사진을 촬영하거나 갤러리에서 가져오세요.\n검색어는 띄어쓰기 또는 쉼표로 구분합니다."
            android:textColor="@color/sc_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
