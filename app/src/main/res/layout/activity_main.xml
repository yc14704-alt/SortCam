<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera is the default home screen: launch and shoot immediately. -->
    <FrameLayout
        android:id="@+id/cameraPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="카메라 미리보기" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp">

            <Button
                android:id="@+id/btnCategoryPicker"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_camera_chip"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="💼 업무  ▾"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSwitchCamera"
                android:layout_width="54dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_camera_chip"
                android:contentDescription="전면 후면 카메라 전환"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="↻"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCameraStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="72dp"
            android:background="@drawable/bg_camera_chip"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="카메라 준비 중"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/recordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="112dp"
            android:background="@drawable/bg_camera_chip"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Optional post-capture action. It never blocks the next shot. -->
        <LinearLayout
            android:id="@+id/quickSaveBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="132dp"
            android:background="@drawable/bg_camera_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="5dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtQuickSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사진 저장됨 · #사진"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnQuickTag"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="태그 추가"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="bottom"
            android:background="#B3000000"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:id="@+id/btnOpenLibrary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:orientation="vertical"
                android:paddingTop="15dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp">
                    <ImageView
                        android:id="@+id/imgLatest"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_secondary_button"
                        android:contentDescription="최근 사진 또는 동영상, 앨범 열기"
                        android:scaleType="centerCrop" />
                    <TextView
                        android:id="@+id/txtLatestType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:background="#B3000000"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </FrameLayout>
                <TextView
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:text="앨범"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_shutter_photo"
                android:contentDescription="촬영"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text=""
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="vertical"
                android:paddingTop="22dp">
                <Button
                    android:id="@+id/btnModeToggle"
                    android:layout_width="86dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_camera_chip"
                    android:minWidth="0dp"
                    android:text="📷 사진"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="86dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="3dp"
                    android:text="눌러서 전환"
                    android:textColor="#D0FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Gallery/search screen, opened from the bottom-left recent thumbnail. -->
    <LinearLayout
        android:id="@+id/libraryPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sc_background"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/sc_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/btnCloseLibrary"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_secondary_button"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="‹ 카메라"
                android:textAllCaps="false"
                android:textColor="@color/sc_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SortCam 앨범"
                android:textColor="@color/sc_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnManageCategories"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_secondary_button"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="분류"
                android:textAllCaps="false"
                android:textColor="@color/sc_text" />
        </LinearLayout>

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:hint="🔎 사진·동영상·계약서·송장번호·전화번호 검색"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_primary_button"
                android:text="전체"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnFilterPhotos"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_secondary_button"
                android:text="📷 사진"
                android:textAllCaps="false"
                android:textColor="@color/sc_text" />
            <Button
                android:id="@+id/btnFilterVideos"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_secondary_button"
                android:text="🎬 동영상"
                android:textAllCaps="false"
                android:textColor="@color/sc_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPhotoCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="전체 0개"
            android:textColor="@color/sc_muted"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photoRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="아직 저장된 미디어가 없습니다.\n‹ 카메라를 눌러 첫 사진이나 동영상을 찍어보세요."
            android:textColor="@color/sc_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
